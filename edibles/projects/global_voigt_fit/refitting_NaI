"""
Creates missing .sav files (chisqr / redchi) for all sightline folders.
 
Edit FITS_ROOT to match your system if needed.
"""
 
from pathlib import Path
import numpy as np
import pandas as pd
 
FITS_ROOT = Path(r'C:\Users\User\Downloads\PYTHON PROJECTS\edibles\edibles\data\voigt_fitting_data\NaI fits')
 
 
def create_missing_sav_files(fits_root: Path = FITS_ROOT):
    for elem_dir in fits_root.iterdir():
        if not elem_dir.is_dir():
            continue
        for star_dir in elem_dir.iterdir():
            if not star_dir.is_dir():
                continue
 
            star_name = star_dir.name
            elem_str  = elem_dir.name.replace(' fits', '')
 
            csv_path     = star_dir / f'{star_name}_{elem_str}.csv'
            dat_path     = star_dir / f'{star_name}_{elem_str}.dat'
            bestfit_path = star_dir / f'{star_name}_{elem_str}_bestfit.dat'
            sav_path     = star_dir / f'{star_name}_{elem_str}.sav'
 
            if sav_path.exists():
                print(f'[SKIP]  {star_name} ({elem_str}) — .sav already exists.')
                continue
 
            if not csv_path.exists() or not dat_path.exists() or not bestfit_path.exists():
                missing = [f.name for f in [csv_path, dat_path, bestfit_path] if not f.exists()]
                print(f'[SKIP]  {star_name} ({elem_str}) — missing: {", ".join(missing)}')
                continue
 
            print(f'[CALC]  {star_name} ({elem_str})...')
            try:
                dat     = np.genfromtxt(dat_path, unpack=True)
                flux    = dat[1]
                err     = dat[2]
                wave    = dat[0]
                bestfit = np.genfromtxt(bestfit_path)
 
                fit_df = pd.read_csv(csv_path)
 
                # build per-point weights from fit windows
                range_df = fit_df[['w_min', 'w_max', 'weight']].drop_duplicates().sort_values('w_min').reset_index(drop=True)
                weights = np.ones(len(wave))
                for _, row in range_df.iterrows():
                    mask = (wave >= row['w_min']) & (wave <= row['w_max'])
                    weights[mask] = row['weight']
 
                # degrees of freedom: v_rad + b per v_comp, one N per n_comp
                n_params = fit_df['v_comp'].nunique() * 2 + fit_df['n_comp'].nunique()
                nfree    = len(flux) - n_params
 
                residuals = (flux - bestfit) / err
                chisqr    = float(np.sum(weights * residuals**2))
                redchi    = chisqr / nfree
 
                with open(sav_path, 'w') as f:
                    f.write(f'chisqr: {chisqr}\n')
                    f.write(f'redchi: {redchi}\n')
 
                print(f'[SAVED] {sav_path.name}  (chisqr={chisqr:.3f}, redchi={redchi:.3f})')
 
            except Exception as e:
                print(f'[ERROR] {star_name} ({elem_str}): {e}')
 
 
if __name__ == '__main__':
    create_missing_sav_files()